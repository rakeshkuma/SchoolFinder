# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_DB=india_school_finder
POSTGRES_USER=isf_app
# Generate e.g. with: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
# At least 32 bytes of random data, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# First administrator, created only when no admin exists. Remove the password after first start.
ADMIN_BOOTSTRAP_USERNAME=
# Minimum 12 characters.
ADMIN_BOOTSTRAP_PASSWORD=

# Load the bundled source-linked seed CSV on first start (dev profile only).
SEED_ENABLED=true

# --- Member accounts ---
# Signed-in sessions end after this much inactivity unless "keep me signed in" (30 days) is chosen.
SESSION_TIMEOUT=2h
# Account email (verification and password reset). Leave SPRING_MAIL_HOST empty to send nothing: sign-up still
# works, but the pages say that no email can be sent. Use a transactional email provider's SMTP credentials.
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Optional "Continue with Google" (Google Cloud OAuth client, type "Web application"; see DEPLOYMENT.md 4a).
# Leave empty to hide the option.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: Cloudinary image uploads (leave empty to register image URLs instead) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=india-school-finder

# --- Production only (docker-compose.prod.yml) ---
# Public https address of the site; used as the only allowed CORS origin.
PUBLIC_SITE_URL=
# Host port for the nginx container (put your TLS proxy in front of it).
FRONTEND_PORT=80
# Swagger UI and /v3/api-docs; off by default in production.
SWAGGER_ENABLED=false

# --- Frontend ---
VITE_API_BASE_URL=
VITE_CONTACT_EMAIL=
