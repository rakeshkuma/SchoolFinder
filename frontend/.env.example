# Base URL of the Spring Boot API. Leave empty in development: Vite proxies /api to localhost:8080.
# In production set it to the public API origin, e.g. https://api.indiaschoolfinder.example
VITE_API_BASE_URL=

# Contact address shown on the Contact Us page (no contact form is used, to avoid collecting personal data).
VITE_CONTACT_EMAIL=
